### .env.example - Não versionar o arquivo .env com segredos reais
# Copie este arquivo para .env e ajuste os valores locais

# Senha do usuário SYS do Oracle (usada pelo container para inicializar o DB)
ORACLE_SYS_PASSWORD=ChangeMe123!

# Banco de dados - credenciais do usuário da aplicação
DB_USER=ecoflow
DB_PASSWORD=ecoflow123

# Ports
ORACLE_PORT=1521
API_PORT=8080

# Spring profiles
SPRING_PROFILES_ACTIVE=dev

# JWT secret (mínimo 32 caracteres em produção)
JWT_SECRET=change-me-with-32-or-more-chars-please

# Imagem/container registry
IMAGE_NAME=ghcr.io/SEU_USUARIO/ecoflow-esg
# IMAGE_TAG padrão: latest (em produção forneça uma tag explícita)
IMAGE_TAG=latest

# Observação: nunca comite o arquivo .env que contenha segredos reais.
